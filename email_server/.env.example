# Configuración del servidor de correo
PORT=3000

# Configuración de Gmail
# IMPORTANTE: Debes crear una "Contraseña de aplicación" en tu cuenta de Gmail
# 1. Ve a https://myaccount.google.com/security
# 2. Activa la verificación en dos pasos
# 3. Ve a https://myaccount.google.com/apppasswords
# 4. Crea una contraseña de aplicación para "Correo"
# 5. Copia esa contraseña aquí (sin espacios)

EMAIL_USER=tu-correo@gmail.com
EMAIL_PASSWORD=tu-contraseña-de-aplicacion

# Alternativa para Outlook:
# Para usar Outlook, cambia el servicio en server.js de 'gmail' a 'outlook'
# EMAIL_USER=tu-correo@outlook.com
# EMAIL_PASSWORD=tu-contraseña
