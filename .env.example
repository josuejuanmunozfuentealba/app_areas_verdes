# Configuración SMTP para envío de correos
# Copiar este archivo a .env y completar con tus credenciales

# Servidor SMTP (Gmail por defecto)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Credenciales de correo
# IMPORTANTE: Usar "Contraseña de aplicación" de Gmail, no tu contraseña real
# https://myaccount.google.com/apppasswords
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-contraseña-de-aplicación-aquí

# Configuración de Supabase (opcional)
SUPABASE_URL=https://speneggmlqitgfjhzsry.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aquí
